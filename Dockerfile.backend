# Backend (FastAPI + YOLOv8 + SQLite) - production container.
FROM python:3.11-slim

WORKDIR /app

# System deps OpenCV needs at runtime (headless - no GUI libs needed on a server)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Render/Railway/Fly inject $PORT at runtime - the app must bind to it, not a
# hardcoded port. Default 8000 is only for local `docker run` without $PORT set.
ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT}"]

# Copy to .env for local runs, or set these in your hosting platform's
# environment-variable settings.

# REQUIRED before any real deployment - generate with: openssl rand -hex 32
TMS_JWT_SECRET=change-me-to-a-real-random-secret

# Dashboard only: URL of the backend it should talk to.
TMS_API_BASE=http://127.0.0.1:8000
